{
  "manifest_version": 3,
  "name": "Auction Coach — ESPN Live Sync",
  "version": "1.0.0",
  "description": "Streams nominations, live bids, and won picks from your ESPN auction draft room to Auction Coach.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://fantasy.espn.com/*",
    "https://*.supabase.co/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Auction Coach"
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://fantasy.espn.com/*draft*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://fantasy.espn.com/*draft*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}
